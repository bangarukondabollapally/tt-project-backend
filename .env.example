# Backend Environment Variables
#
# Copy this file to .env and fill in real values for local development.
# .env is gitignored — never commit real credentials.

# -- Database ------------------------------------------------------------------
# Local example: DB_HOST=localhost, DB_PORT=3306, DB_NAME=ttproject, DB_SSL_MODE=DISABLED
# Aiven example: use the host, port and database name from the Aiven console, with DB_SSL_MODE=REQUIRED
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ttproject
DB_SSL_MODE=your_db_ssl_mode_here
DB_USERNAME=your_db_username_here
DB_PASSWORD=your_db_password_here

# -- Frontend & CORS -----------------------------------------------------------
# Example: FRONTEND_URL=http://localhost:5173
FRONTEND_URL=your_frontend_url_here
